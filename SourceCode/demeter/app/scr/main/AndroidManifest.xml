<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.Lexus2025.demeter">

    <!-- Overlay para captura sin colapso -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- Servicio en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>

    <!-- Almacenamiento para instalar/desinstalar módulos -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <!-- Instalar APKs de módulos (API 26+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Tienda de shaders: descarga índice y archivos .demeter -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@raw/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:resizeableActivity="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ✅ ACTIVIDADES AGREGADAS PARA SOLUCIONAR EL CRASH -->
        <activity android:name=".CaptureAreaActivity" />
        <activity android:name=".OverlayPositionActivity" />
        <activity android:name=".ShaderStoreActivity" />

        <service
            android:name=".CaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>

    </application>
</manifest>


