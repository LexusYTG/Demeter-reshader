<?xml version="1.0" encoding="utf-8"?>
<!-- Botón circular de Importar: azul con degradé y estado presionado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#1565C0"
                android:endColor="#0D47A1" />
            <stroke android:width="1dp" android:color="#82B1FF" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#42A5F5"
                android:endColor="#1976D2" />
            <stroke android:width="1dp" android:color="#BBDEFB" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
</selector>
