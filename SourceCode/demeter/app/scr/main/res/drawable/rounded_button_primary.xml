<?xml version="1.0" encoding="utf-8"?>
<!-- Botón primario (Iniciar/Cancelar captura): verde-teal vivo, para que
destaque como la acción principal frente a los botones secundarios. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="90"
                android:startColor="#00A85C"
                android:endColor="#00695C" />
            <stroke android:width="1dp" android:color="#69F0AE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="90"
                android:startColor="#00E676"
                android:endColor="#00897B" />
            <stroke android:width="1dp" android:color="#B9F6CA" />
        </shape>
    </item>
</selector>

