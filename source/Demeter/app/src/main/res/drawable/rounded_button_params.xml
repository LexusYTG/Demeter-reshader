<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de Parámetros: ámbar, para diferenciarlo visualmente como acción
de "ajuste" frente a las acciones verdes/azules de captura. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="#E65100"
                android:endColor="#BF360C" />
            <stroke android:width="1dp" android:color="#FFB300" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="#FFA000"
                android:endColor="#EF6C00" />
            <stroke android:width="1dp" android:color="#FFD54F" />
        </shape>
    </item>
</selector>

