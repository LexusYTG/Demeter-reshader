<?xml version="1.0" encoding="utf-8"?>
<!-- Botón secundario (Área captura / Overlay / Seleccionar): slate-teal con
degradé sutil y estado "presionado" para que se sienta táctil. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="#2B3B40"
                android:endColor="#1C2A2E" />
            <stroke android:width="1dp" android:color="#26A69A" />
            <padding android:left="20dp" android:top="10dp" android:right="20dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="#3E5459"
                android:endColor="#2C3E42" />
            <stroke android:width="1dp" android:color="#4DB6AC" />
            <padding android:left="20dp" android:top="10dp" android:right="20dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>

