{
  "name": "Candy",
  "author": "LexusYTG",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uIntensity;\nuniform float uBrightness;\nuniform float uPink;\nvoid main() {\n    vec3 src = texture2D(uTexture, vTexCoord).rgb;\n    src = mix(src, vec3(0.5), 0.15);\n    float lum = dot(src, vec3(0.299, 0.587, 0.114));\n    vec3 sat = mix(vec3(lum), src, 1.5);\n    vec3 tint = vec3(1.0 + uPink * 0.1, 1.0, 1.0 + uPink * 0.08);\n    vec3 col = sat * tint + vec3(0.05, 0.02, 0.08);\n    col += uBrightness * 0.15;\n    gl_FragColor = vec4(clamp(mix(src, col, uIntensity), 0.0, 1.0), 1.0);\n}\n",
  "paramDefs": {
    "uIntensity": {
      "label": "Intensidad",
      "min": 0.0,
      "max": 1.0,
      "default": 0.8
    },
    "uBrightness": {
      "label": "Brillo",
      "min": -0.5,
      "max": 1.0,
      "default": 0.3
    },
    "uPink": {
      "label": "Tinte rosa",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5
    }
  },
  "params": {
    "uIntensity": 0.8,
    "uBrightness": 0.3,
    "uPink": 0.5
  }
}