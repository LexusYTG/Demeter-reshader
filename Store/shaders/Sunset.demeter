{
  "name": "Sunset",
  "author": "Pix",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uIntensity;\nuniform float uWarmth;\nuniform float uBloom;\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec3 src = texture2D(uTexture, uv).rgb;\n    float lum = dot(src, vec3(0.299, 0.587, 0.114));\n    vec3 warm = vec3(1.15, 0.75, 0.55);\n    vec3 pink = vec3(1.10, 0.60, 0.90);\n    vec3 mix1 = mix(warm, pink, uv.y);\n    vec3 col = src * mix1;\n    col += vec3(smoothstep(0.7, 1.0, lum)) * uBloom * 0.4 * mix1;\n    col = mix(src, col, uIntensity);\n    gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);\n}\n",
  "paramDefs": {
    "uIntensity": {
      "label": "Intensidad",
      "min": 0.0,
      "max": 1.0,
      "default": 0.7
    },
    "uWarmth": {
      "label": "Calidez",
      "min": 0.0,
      "max": 1.0,
      "default": 0.6
    },
    "uBloom": {
      "label": "Bloom",
      "min": 0.0,
      "max": 1.0,
      "default": 0.4
    }
  },
  "params": {
    "uIntensity": 0.7,
    "uWarmth": 0.6,
    "uBloom": 0.4
  }
}