{
  "name": "Paper",
  "author": "Ale",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uIntensity;\nuniform float uWarmth;\nvoid main() {\n    vec3 src = texture2D(uTexture, vTexCoord).rgb;\n    float lum = dot(src, vec3(0.299, 0.587, 0.114));\n    vec3 cool = vec3(0.95, 0.96, 0.98);\n    vec3 warm = vec3(1.0, 0.94, 0.82);\n    vec3 paper = mix(cool, warm, uWarmth);\n    vec3 ink = vec3(0.12, 0.10, 0.09);\n    vec3 col = mix(ink, paper, lum);\n    gl_FragColor = vec4(mix(src, col, uIntensity), 1.0);\n}\n",
  "paramDefs": {
    "uIntensity": {
      "label": "Intensidad",
      "min": 0.0,
      "max": 1.0,
      "default": 0.9
    },
    "uWarmth": {
      "label": "Calidez",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5
    }
  },
  "params": {
    "uIntensity": 0.9,
    "uWarmth": 0.5
  }
}