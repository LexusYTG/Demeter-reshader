{
  "name": "Sonar",
  "author": "Kira",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uSpeed;\nuniform float uRings;\nuniform float uIntensity;\nuniform float uTime;\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec2 c = uv - 0.5;\n    float r = length(c);\n    float t = uTime * uSpeed;\n    float waves = 0.0;\n    for (int i = 0; i < 4; i++) {\n        float fi = float(i);\n        float phase = fract(t - fi * 0.25);\n        float ringR = phase * 0.7;\n        float w = 1.0 - phase;\n        float d = abs(r - ringR);\n        waves += smoothstep(0.03, 0.0, d) * w;\n    }\n    waves *= uIntensity;\n    vec3 src = texture2D(uTexture, uv).rgb;\n    vec3 col = src + vec3(waves * 0.6, waves * 0.9, waves * 1.0);\n    col *= 1.0 - uRings * r * 0.5;\n    gl_FragColor = vec4(col, 1.0);\n}\n",
  "params": { "uTime": 0.0 },
  "paramDefs": {
    "uSpeed":     { "label": "Velocidad", "min": 0.2, "max": 3.0, "default": 1.0 },
    "uRings":     { "label": "Ondas", "min": 0.0, "max": 1.0, "default": 0.3 },
    "uIntensity": { "label": "Intensidad", "min": 0.0, "max": 2.0, "default": 1.0 },
    "uTime":      { "label": "Animación", "min": 0.0, "max": 1.0, "default": 0.0 }
  }
}
