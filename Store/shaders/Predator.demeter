{
  "name": "Predator",
  "author": "LexusYTG",
  "version": "1.0",
  "type": "MODIFIER",
  "description": "Visor térmico del Depredador: azul para lo frío, amarillo para lo tibio, rojo para lo caliente. Con rejilla de sensor y scanlines sutiles. Cazá en primera persona.",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uHeat;\nuniform float uGrid;\nuniform float uSensor;\nuniform float uVignette;\n\nfloat luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }\n\nvoid main() {\n    vec2 uv = vTexCoord;\n    \n    vec2 cellSize = vec2(uSensor * 0.0025, uSensor * 0.0044);\n    vec2 cellUV = (floor(uv / cellSize) + 0.5) * cellSize;\n    float sensorLuma = luma(texture2D(uTexture, cellUV).rgb);\n    float sharpLuma  = luma(texture2D(uTexture, uv).rgb);\n    float heat = mix(sharpLuma, sensorLuma, 0.55);\n    \n    heat = clamp(heat * uHeat, 0.0, 1.0);\n    \n    vec3 cool   = vec3(0.05, 0.15, 0.55);\n    vec3 warm   = vec3(0.95, 0.85, 0.10);\n    vec3 hot    = vec3(1.00, 0.10, 0.05);\n    vec3 white  = vec3(1.00, 1.00, 1.00);\n    \n    vec3 col = cool;\n    col = mix(col, warm,  clamp((heat - 0.15) * 1.6, 0.0, 1.0));\n    col = mix(col, hot,   clamp((heat - 0.55) * 2.5, 0.0, 1.0));\n    col = mix(col, white, clamp((heat - 0.92) * 8.0, 0.0, 1.0));\n    \n    float gridX = step(0.985, fract(uv.x / (cellSize.x * 4.0)));\n    float gridY = step(0.985, fract(uv.y / (cellSize.y * 4.0)));\n    float grid = max(gridX, gridY) * uGrid;\n    col += vec3(0.15, 0.25, 0.35) * grid;\n    \n    float scan = 1.0 - 0.10 * step(0.5, fract(uv.y * 480.0));\n    col *= scan;\n    \n    vec2 c = uv - 0.5;\n    float vig = 1.0 - dot(c, c) * uVignette;\n    col *= vig;\n    \n    col = clamp(col, 0.0, 1.0);\n    gl_FragColor = vec4(col, 1.0);\n}\n",
  "params": {
    "uHeat": 1.4,
    "uGrid": 0.5,
    "uSensor": 1.0,
    "uVignette": 0.9
  },
  "paramDefs": {
    "uHeat":     { "label": "Ganancia térmica", "min": 0.5, "max": 3.0, "default": 1.4 },
    "uGrid":     { "label": "Rejilla sensor",   "min": 0.0, "max": 1.0, "default": 0.5 },
    "uSensor":   { "label": "Granulado sensor","min": 0.5, "max": 3.0, "default": 1.0 },
    "uVignette": { "label": "Viñeteado",        "min": 0.0, "max": 2.0, "default": 0.9 }
  }
}
