{
  "name": "Warp",
  "author": "Runa",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision highp float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uStrength;\nuniform float uSpeed;\nuniform float uChroma;\nuniform float uTime;\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec2 c = uv - 0.5;\n    float r = length(c);\n    float t = uTime * uSpeed;\n    float warp = uStrength * (0.5 - r) * (0.5 + 0.5 * sin(t + r * 20.0));\n    vec2 wUV = uv + normalize(c + 0.0001) * warp * 0.5;\n    vec2 chOff = normalize(c + 0.0001) * uChroma * 0.01;\n    vec3 col;\n    col.r = texture2D(uTexture, wUV + chOff).r;\n    col.g = texture2D(uTexture, wUV).g;\n    col.b = texture2D(uTexture, wUV - chOff).b;\n    gl_FragColor = vec4(col, 1.0);\n}\n",
  "params": {
    "uTime": 0.0,
    "uStrength": 0.8,
    "uSpeed": 1.5,
    "uChroma": 1.0
  },
  "paramDefs": {
    "uStrength": {
      "label": "Fuerza",
      "min": 0.0,
      "max": 2.0,
      "default": 0.8
    },
    "uSpeed": {
      "label": "Velocidad",
      "min": 0.0,
      "max": 4.0,
      "default": 1.5
    },
    "uChroma": {
      "label": "Aberración",
      "min": 0.0,
      "max": 3.0,
      "default": 1.0
    },
    "uTime": {
      "label": "Animación",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0
    }
  }
}