{
  "name": "Blueprint",
  "author": "Ale",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uEdgeStr;\nuniform float uGridSize;\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec2 texelSize = vec2(0.002, 0.002);\n    vec4 col = texture2D(uTexture, uv);\n    vec4 r = texture2D(uTexture, uv + vec2(texelSize.x, 0.0));\n    vec4 l = texture2D(uTexture, uv - vec2(texelSize.x, 0.0));\n    vec4 u = texture2D(uTexture, uv + vec2(0.0, texelSize.y));\n    vec4 d = texture2D(uTexture, uv - vec2(0.0, texelSize.y));\n    vec3 edge = abs(r.rgb - l.rgb) + abs(u.rgb - d.rgb);\n    float edgeLum = dot(edge, vec3(0.333)) * uEdgeStr * 4.0;\n    float grid = max(\n        step(1.0 - 0.03, fract(uv.x * uGridSize)),\n        step(1.0 - 0.03, fract(uv.y * uGridSize))\n    ) * 0.15;\n    vec3 bg = vec3(0.02, 0.12, 0.28);\n    vec3 lines = vec3(0.3, 0.65, 1.0);\n    vec3 result = bg + lines * (edgeLum + grid);\n    gl_FragColor = vec4(clamp(result, 0.0, 1.0), col.a);\n}",
  "params": {
    "uEdgeStr": 1.0,
    "uGridSize": 20.0
  },
  "paramDefs": {
    "uEdgeStr": { "label": "Contornos", "min": 0.0, "max": 3.0, "default": 1.0 },
    "uGridSize": { "label": "Tamaño de grilla", "min": 5.0, "max": 60.0, "default": 20.0 }
  }
}
