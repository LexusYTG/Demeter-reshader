{
  "name": "Origami",
  "author": "Yuki",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uFolds;\nuniform float uShade;\nuniform float uTime;\nvoid main() {\n    vec2 uv = vTexCoord;\n    float folds = max(2.0, floor(uFolds));\n    float ang = uv.x * folds + uv.y * folds * 0.5 + uTime * 0.2;\n    float facet = floor(ang);\n    float inFacet = fract(ang);\n    float tri = inFacet < 0.5 ? 1.0 : -1.0;\n    vec2 p1 = vec2(fract(facet / folds), floor(facet / folds) / folds);\n    vec2 localUV = uv + (p1 - 0.5) * 0.02;\n    vec3 col = texture2D(uTexture, localUV).rgb;\n    float shade = mix(0.7, 1.15, inFacet) * mix(0.85, 1.1, tri * 0.5 + 0.5);\n    col *= mix(1.0, shade, uShade);\n    gl_FragColor = vec4(col, 1.0);\n}\n",
  "params": {
    "uTime": 0.0,
    "uFolds": 8.0,
    "uShade": 0.7
  },
  "paramDefs": {
    "uFolds": {
      "label": "Pliegues",
      "min": 3.0,
      "max": 25.0,
      "default": 8.0
    },
    "uShade": {
      "label": "Sombra",
      "min": 0.0,
      "max": 1.0,
      "default": 0.7
    },
    "uTime": {
      "label": "Animación",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0
    }
  }
}