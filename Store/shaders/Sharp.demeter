{
  "name": "Sharp",
  "author": "Ale",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uAmount;\nuniform float uRadius;\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec2 px = vec2(uRadius) * 0.001;\n    vec3 center = texture2D(uTexture, uv).rgb;\n    vec3 n = texture2D(uTexture, uv + vec2(0.0, -px.y)).rgb;\n    vec3 s = texture2D(uTexture, uv + vec2(0.0,  px.y)).rgb;\n    vec3 e = texture2D(uTexture, uv + vec2( px.x, 0.0)).rgb;\n    vec3 w = texture2D(uTexture, uv + vec2(-px.x, 0.0)).rgb;\n    vec3 blur = (n + s + e + w) * 0.25;\n    vec3 res = center + (center - blur) * uAmount;\n    gl_FragColor = vec4(clamp(res, 0.0, 1.0), 1.0);\n}\n",
  "paramDefs": {
    "uAmount": {
      "label": "Cantidad",
      "min": 0.0,
      "max": 5.0,
      "default": 1.5
    },
    "uRadius": {
      "label": "Radio",
      "min": 0.5,
      "max": 8.0,
      "default": 2.0
    }
  },
  "params": {
    "uAmount": 1.5,
    "uRadius": 2.0
  }
}