{
  "name": "Coals",
  "author": "Ember",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uIntensity;\nuniform float uSpeed;\nuniform float uTime;\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec3 src = texture2D(uTexture, uv).rgb;\n    float lum = dot(src, vec3(0.299, 0.587, 0.114));\n    float glow = smoothstep(0.35, 0.0, lum);\n    float pulse = 0.7 + 0.3 * sin(uTime * uSpeed);\n    vec3 coalColor = vec3(1.0, 0.35, 0.1) * glow * pulse;\n    vec3 col = src + coalColor * uIntensity;\n    vec3 dark = src * 0.6;\n    col = mix(col, dark + coalColor, 0.7);\n    gl_FragColor = vec4(col, 1.0);\n}\n",
  "params": {
    "uTime": 0.0,
    "uIntensity": 1.0,
    "uSpeed": 1.2
  },
  "paramDefs": {
    "uIntensity": {
      "label": "Intensidad",
      "min": 0.0,
      "max": 2.0,
      "default": 1.0
    },
    "uSpeed": {
      "label": "Pulso",
      "min": 0.1,
      "max": 4.0,
      "default": 1.2
    },
    "uTime": {
      "label": "Animación",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0
    }
  }
}