{
  "name": "Pixel Sort",
  "author": "Fractal",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision highp float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uThreshold;\nuniform float uLength;\nuniform float uDirection;\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec3 src = texture2D(uTexture, uv).rgb;\n    float lum = dot(src, vec3(0.299, 0.587, 0.114));\n    vec2 dir = (uDirection < 0.5) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);\n    vec2 off = dir * 0.004;\n    vec3 best = src;\n    float bestLum = lum;\n    for (int i = 1; i <= 8; i++) {\n        float f = float(i);\n        if (f > uLength) break;\n        vec2 sUV = uv - off * f;\n        vec3 s = texture2D(uTexture, sUV).rgb;\n        float sLum = dot(s, vec3(0.299, 0.587, 0.114));\n        if (sLum > uThreshold && sLum > bestLum) {\n            best = s;\n            bestLum = sLum;\n        }\n    }\n    gl_FragColor = vec4(best, 1.0);\n}\n",
  "paramDefs": {
    "uThreshold": {
      "label": "Umbral",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5
    },
    "uLength": {
      "label": "Longitud",
      "min": 1.0,
      "max": 8.0,
      "default": 6.0
    },
    "uDirection": {
      "label": "Dirección",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0
    }
  },
  "params": {
    "uThreshold": 0.5,
    "uLength": 6.0,
    "uDirection": 0.0
  }
}