{
  "name": "Tape Pause",
  "author": "Zeta",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uBars;\nuniform float uIntensity;\nuniform float uJitter;\nuniform float uTime;\nfloat hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nvoid main() {\n    vec2 uv = vTexCoord;\n    float bar = floor(uv.y * uBars);\n    float seed = hash(vec2(bar, floor(uTime * 4.0)));\n    float activity = step(0.7, seed);\n    float jitter = (hash(vec2(bar, uTime * 8.0)) - 0.5) * uJitter * 0.3 * activity;\n    vec2 srcUV = vec2(fract(uv.x + jitter), uv.y);\n    vec3 col = texture2D(uTexture, srcUV).rgb;\n    col = mix(col, vec3(0.85, 0.85, 0.9), activity * uIntensity * 0.4);\n    col += (hash(srcUV * 300.0 + uTime * 20.0) - 0.5) * 0.15 * activity;\n    gl_FragColor = vec4(col, 1.0);\n}\n",
  "params": {
    "uTime": 0.0,
    "uBars": 6.0,
    "uIntensity": 0.7,
    "uJitter": 1.2
  },
  "paramDefs": {
    "uBars": {
      "label": "Bandas",
      "min": 2.0,
      "max": 20.0,
      "default": 6.0
    },
    "uIntensity": {
      "label": "Intensidad",
      "min": 0.0,
      "max": 1.0,
      "default": 0.7
    },
    "uJitter": {
      "label": "Jitter",
      "min": 0.0,
      "max": 3.0,
      "default": 1.2
    },
    "uTime": {
      "label": "Animación",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0
    }
  }
}