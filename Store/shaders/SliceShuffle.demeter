{
  "name": "Slice Shuffle",
  "author": "Zeta",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uSlices;\nuniform float uIntensity;\nuniform float uSpeed;\nuniform float uTime;\nfloat hash(float n){ return fract(sin(n) * 43758.5453); }\nvoid main() {\n    vec2 uv = vTexCoord;\n    float slices = max(2.0, floor(uSlices));\n    float t = floor(uTime * uSpeed * 5.0);\n    float slice = floor(uv.y * slices);\n    float r = hash(slice + t);\n    float isActive = step(1.0 - uIntensity, r);\n    float off = (hash(slice * 7.0 + t) - 0.5) * 0.3 * isActive;\n    vec2 src = vec2(fract(uv.x + off), uv.y);\n    gl_FragColor = vec4(texture2D(uTexture, src).rgb, 1.0);\n}\n",
  "params": {
    "uTime": 0.0,
    "uSlices": 20.0,
    "uIntensity": 0.4,
    "uSpeed": 1.5
  },
  "paramDefs": {
    "uSlices": {
      "label": "Cortes",
      "min": 5.0,
      "max": 60.0,
      "default": 20.0
    },
    "uIntensity": {
      "label": "Intensidad",
      "min": 0.0,
      "max": 1.0,
      "default": 0.4
    },
    "uSpeed": {
      "label": "Velocidad",
      "min": 0.1,
      "max": 6.0,
      "default": 1.5
    },
    "uTime": {
      "label": "Animación",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0
    }
  }
}