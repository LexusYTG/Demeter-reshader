{
  "name": "Alien",
  "author": "Yuki",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uDensity;\nuniform float uIntensity;\nuniform float uTime;\nfloat hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec2 px = vec2(0.0015);\n    vec3 src = texture2D(uTexture, uv).rgb;\n    vec3 n = texture2D(uTexture, uv + vec2(0.0, -px.y)).rgb;\n    vec3 s = texture2D(uTexture, uv + vec2(0.0,  px.y)).rgb;\n    vec3 e = texture2D(uTexture, uv + vec2( px.x, 0.0)).rgb;\n    vec3 w = texture2D(uTexture, uv + vec2(-px.x, 0.0)).rgb;\n    float gx = length(e) - length(w);\n    float gy = length(s) - length(n);\n    vec2 grad = normalize(vec2(gx, gy) + 0.0001);\n    vec2 perp = vec2(-grad.y, grad.x);\n    vec2 grid = uv * uDensity;\n    float lines = sin(dot(grid, perp) * 6.28 + uTime * 0.3);\n    lines = smoothstep(0.85, 1.0, lines);\n    float edge = length(vec2(gx, gy));\n    lines *= min(1.0, edge * 20.0);\n    vec3 bone = vec3(0.6, 0.55, 0.45);\n    vec3 metal = vec3(0.15, 0.18, 0.2);\n    vec3 col = mix(metal, bone, edge * 8.0);\n    col += vec3(lines * 0.3 * uIntensity);\n    col = mix(src * 0.2, col, uIntensity);\n    gl_FragColor = vec4(col, 1.0);\n}\n",
  "params": {
    "uTime": 0.0,
    "uDensity": 30.0,
    "uIntensity": 0.8
  },
  "paramDefs": {
    "uDensity": {
      "label": "Densidad",
      "min": 10.0,
      "max": 80.0,
      "default": 30.0
    },
    "uIntensity": {
      "label": "Intensidad",
      "min": 0.0,
      "max": 1.0,
      "default": 0.8
    },
    "uTime": {
      "label": "Animación",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0
    }
  }
}