{
  "name": "Cosmos",
  "author": "Nite",
  "version": "1.0",
  "type": "MODIFIER",
  "vertexShader": "attribute vec4 aPosition;\nattribute vec2 aTexCoord;\nvarying vec2 vTexCoord;\nvoid main() {\n    gl_Position = aPosition;\n    vTexCoord = aTexCoord;\n}\n",
  "fragmentShader": "precision mediump float;\nvarying vec2 vTexCoord;\nuniform sampler2D uTexture;\nuniform float uDensity;\nuniform float uBrightness;\nuniform float uTime;\nfloat hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nvoid main() {\n    vec2 uv = vTexCoord;\n    vec3 src = texture2D(uTexture, uv).rgb;\n    vec2 grid = uv * uDensity;\n    vec2 cell = floor(grid);\n    vec2 f = fract(grid);\n    float h = hash(cell);\n    float star = 0.0;\n    if (h > 0.85) {\n        vec2 pos = vec2(hash(cell + 1.0), hash(cell + 2.0));\n        float d = length(f - pos);\n        float twinkle = 0.7 + 0.3 * sin(uTime * 3.0 + h * 10.0);\n        star = smoothstep(0.06, 0.0, d) * twinkle;\n    }\n    vec3 col = src + vec3(star * uBrightness);\n    gl_FragColor = vec4(col, 1.0);\n}\n",
  "params": { "uTime": 0.0 },
  "paramDefs": {
    "uDensity":    { "label": "Densidad", "min": 5.0, "max": 60.0, "default": 25.0 },
    "uBrightness": { "label": "Brillo", "min": 0.0, "max": 2.0, "default": 0.8 },
    "uTime":       { "label": "Animación", "min": 0.0, "max": 1.0, "default": 0.0 }
  }
}
